<Application
    x:Class="DeltaModelViewer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <!-- 模型库缩略图卡片模板 -->
                    <DataTemplate x:Key="ThumbTemplate">
                        <Border Width="172" Margin="3" CornerRadius="10"
                                Background="{ThemeResource AppTileBackground}" Padding="5"
                                ToolTipService.ToolTip="{Binding RelativePath}">
                            <StackPanel>
                                <Image Source="{Binding Thumbnail}" Width="160" Height="160"
                                       Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding FolderName}" FontSize="11.5"
                                           Foreground="{ThemeResource AppTextValue}" TextTrimming="CharacterEllipsis"
                                           Margin="4,6,4,2" MaxWidth="152" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>

                    <!--
                        主题令牌：浅色 / 深色两套（面板、文字、分隔线、弹层）。
                        原先这里只有一套半透明深色画刷 —— 那是为了让「液态玻璃胶囊」透出背后的 3D 模型；
                        液态玻璃已整体去掉，所以面板改成**不透明**，并按主题分浅色 / 深色两套。
                    -->
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">

                            <!-- 面板 / 卡片 / 弹层 -->
                            <SolidColorBrush x:Key="AppPanelBackground" Color="#FF12161C"/>
                            <SolidColorBrush x:Key="AppPanelBorder" Color="#26FFFFFF"/>
                            <SolidColorBrush x:Key="AppCardBackground" Color="#FF171C23"/>
                            <SolidColorBrush x:Key="AppTileBackground" Color="#FF191E25"/>
                            <SolidColorBrush x:Key="AppPopupBackground" Color="#FF1B2028"/>
                            <SolidColorBrush x:Key="AppOverlayScrim" Color="#F20B0D11"/>
                            <SolidColorBrush x:Key="AppDivider" Color="#24FFFFFF"/>

                            <!-- 文字 -->
                            <SolidColorBrush x:Key="AppTextPrimary" Color="#FFEAF0F7"/>
                            <SolidColorBrush x:Key="AppTextStrong" Color="#FFD5DAE2"/>
                            <SolidColorBrush x:Key="AppTextSecondary" Color="#FF9AA4B0"/>
                            <SolidColorBrush x:Key="AppTextTertiary" Color="#FF7A828E"/>
                            <SolidColorBrush x:Key="AppTextValue" Color="#FFC3CCD8"/>
                            <SolidColorBrush x:Key="AppTextMuted" Color="#FF8E98A5"/>
                            <SolidColorBrush x:Key="AppAccent" Color="#FFFFB27A"/>
                            <SolidColorBrush x:Key="AppDanger" Color="#FFFF8A7A"/>

                            <!-- 输入框（AutoSuggestBox / TextBox）：不透明 -->
                            <SolidColorBrush x:Key="TextControlBackground" Color="#FF14181E"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF1B2129"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF1B2129"/>
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FF0E1116"/>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3DFFFFFF"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#5CFFFFFF"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#B8FFFFFF"/>
                            <SolidColorBrush x:Key="TextControlForeground" Color="#EEF2F7"/>
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#85909D"/>

                            <!-- 按钮：不透明 -->
                            <SolidColorBrush x:Key="ButtonBackground" Color="#FF161B22"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF1E242D"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF262E39"/>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF0E1116"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3DFFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#5CFFFFFF"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#7AFFFFFF"/>

                            <!-- 下拉框：不透明 -->
                            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF14181E"/>
                            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF1B2129"/>
                            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF262E39"/>
                            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FF1B2129"/>
                            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#FF0E1116"/>
                            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3DFFFFFF"/>
                            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#5CFFFFFF"/>
                            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#B8FFFFFF"/>

                            <!-- 弹出层（建议列表 / 菜单） -->
                            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FF1B2028"/>
                            <SolidColorBrush x:Key="FlyoutPresenterBorderBrush" Color="#33FFFFFF"/>

                            <!-- 提示条：不透明 severity 底色 -->
                            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#FF1F262F"/>
                            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#FF11301F"/>
                            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#FF3A2C12"/>
                            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#FF3A161A"/>
                            <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#33FFFFFF"/>

                            <!-- 对话框底色 -->
                            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FF181D24"/>
                            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#33FFFFFF"/>

                        </ResourceDictionary>

                        <ResourceDictionary x:Key="Light">

                            <!-- 面板 / 卡片 / 弹层 -->
                            <SolidColorBrush x:Key="AppPanelBackground" Color="#FFF7F8FB"/>
                            <SolidColorBrush x:Key="AppPanelBorder" Color="#1F000000"/>
                            <SolidColorBrush x:Key="AppCardBackground" Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="AppTileBackground" Color="#FFF1F3F7"/>
                            <SolidColorBrush x:Key="AppPopupBackground" Color="#FFFFFFFF"/>
                            <SolidColorBrush x:Key="AppOverlayScrim" Color="#F2EFF1F6"/>
                            <SolidColorBrush x:Key="AppDivider" Color="#1F000000"/>

                            <!-- 文字 -->
                            <SolidColorBrush x:Key="AppTextPrimary" Color="#FF1B1F26"/>
                            <SolidColorBrush x:Key="AppTextStrong" Color="#FF2A3038"/>
                            <SolidColorBrush x:Key="AppTextSecondary" Color="#FF5A6472"/>
                            <SolidColorBrush x:Key="AppTextTertiary" Color="#FF7C848F"/>
                            <SolidColorBrush x:Key="AppTextValue" Color="#FF3A424C"/>
                            <SolidColorBrush x:Key="AppTextMuted" Color="#FF6B7480"/>
                            <SolidColorBrush x:Key="AppAccent" Color="#FFC2410C"/>
                            <SolidColorBrush x:Key="AppDanger" Color="#FFC62828"/>

                            <!-- 输入框（浅色交给 WinUI 默认即可，这里只补 app 自己的弹层令牌） -->

                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
