<Window
    x:Class="DeltaModelViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="UEFormat模型查看器">

    <Grid x:Name="RootGrid" PointerWheelChanged="Root_PointerWheelChanged">

        <!-- 3D 视口铺满整个窗口（含标题栏区域） -->
        <SwapChainPanel x:Name="ViewportPanel"
                        PointerPressed="Viewport_PointerPressed"
                        PointerMoved="Viewport_PointerMoved"
                        PointerReleased="Viewport_PointerReleased"
                        PointerWheelChanged="Viewport_PointerWheelChanged"
                        PointerExited="Viewport_PointerExited"/>

        <!-- 浮层（空白区域不拦截命中，指针穿透到视口） -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏拖拽区（透明但可命中，右侧避让窗口控制按钮） -->
            <Grid x:Name="TitleBarDrag" Grid.Row="0" Height="40"
                  Margin="0,0,150,0" Background="Transparent"/>

            <!-- 工具栏 -->
            <Border x:Name="TopBar" Grid.Row="1" Margin="14,6,150,0" CornerRadius="14"
                    Background="{ThemeResource AppPanelBackground}"
                    BorderBrush="{ThemeResource AppPanelBorder}" BorderThickness="1" Padding="14,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="GalleryToggle" Grid.Column="0" Content="模型库"
                            Click="GalleryToggle_Click"
                            ToolTipService.ToolTip="显示 / 隐藏模型缩略图画廊"/>

                    <ComboBox x:Name="FileBox" Grid.Column="1" Width="280"
                              PlaceholderText="选择 .uemodel 文件"
                              SelectionChanged="FileBox_SelectionChanged"/>

                    <ToggleSwitch x:Name="NormalSwitch" Grid.Column="2" Header="法线贴图"
                                  IsOn="True" OnContent="开" OffContent="关"
                                  Toggled="NormalSwitch_Toggled"/>

                    <ToggleSwitch x:Name="CullSwitch" Grid.Column="3" Header="双面渲染"
                                  IsOn="False" OnContent="开" OffContent="关"
                                  Toggled="CullSwitch_Toggled"/>

                    <!-- 金属度 / 粗糙度滑条 -->
                    <StackPanel Grid.Column="4" Width="128" Spacing="2" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="金属度" FontSize="11" Foreground="{ThemeResource AppTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MetallicValue" Grid.Column="1" Text="0.00" FontSize="11"
                                       Foreground="{ThemeResource AppTextTertiary}" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="MetallicSlider" Minimum="0" Maximum="1" StepFrequency="0.01"
                                Value="0" IsThumbToolTipEnabled="False"
                                ValueChanged="MetallicSlider_ValueChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Width="128" Spacing="2" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="粗糙度" FontSize="11" Foreground="{ThemeResource AppTextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RoughnessValue" Grid.Column="1" Text="0.60" FontSize="11"
                                       Foreground="{ThemeResource AppTextTertiary}" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="RoughnessSlider" Minimum="0" Maximum="1" StepFrequency="0.01"
                                Value="0.6" IsThumbToolTipEnabled="False"
                                ValueChanged="RoughnessSlider_ValueChanged"/>
                    </StackPanel>

                    <!-- 灯光调整 Flyout -->
                    <Button Grid.Column="6" Content="灯光" ToolTipService.ToolTip="调整主光方向与强度">
                        <Button.Flyout>
                            <Flyout Opening="LightFlyout_Opening">
                                <Border Background="{ThemeResource AppPopupBackground}" CornerRadius="12"
                                        BorderBrush="{ThemeResource AppPanelBorder}" BorderThickness="1" Padding="18,14">
                                    <StackPanel Width="264" Spacing="12">
                                        <TextBlock Text="灯光设置" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}"/>

                                        <StackPanel Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="方位角" FontSize="11.5" Foreground="{ThemeResource AppTextSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LightAzimuthValue" Grid.Column="1" Text="66°" FontSize="11.5" Foreground="{ThemeResource AppTextTertiary}"/>
                                            </Grid>
                                            <Slider x:Name="LightAzimuthSlider" Tag="azimuth" Minimum="0" Maximum="360"
                                                    StepFrequency="1" Value="66" IsThumbToolTipEnabled="False"
                                                    ValueChanged="LightSlider_ValueChanged"/>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="高度角" FontSize="11.5" Foreground="{ThemeResource AppTextSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LightElevationValue" Grid.Column="1" Text="30°" FontSize="11.5" Foreground="{ThemeResource AppTextTertiary}"/>
                                            </Grid>
                                            <Slider x:Name="LightElevationSlider" Tag="elevation" Minimum="0" Maximum="85"
                                                    StepFrequency="1" Value="30" IsThumbToolTipEnabled="False"
                                                    ValueChanged="LightSlider_ValueChanged"/>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="强度" FontSize="11.5" Foreground="{ThemeResource AppTextSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="LightIntensityValue" Grid.Column="1" Text="3.60" FontSize="11.5" Foreground="{ThemeResource AppTextTertiary}"/>
                                            </Grid>
                                            <Slider x:Name="LightIntensitySlider" Tag="intensity" Minimum="0.5" Maximum="8"
                                                    StepFrequency="0.1" Value="3.6" IsThumbToolTipEnabled="False"
                                                    ValueChanged="LightSlider_ValueChanged"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Grid.Column="7" Content="背景" Click="BackgroundButton_Click"
                            ToolTipService.ToolTip="更换背景图（同时自动更新环境光）"/>

                    <!-- 导出模型：FBX / OBJ -->
                    <Button Grid.Column="8" Content="导出" ToolTipService.ToolTip="导出当前模型为 FBX / OBJ 文件">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="导出为 FBX…" Click="ExportFbx_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B5;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="导出为 OBJ…" Click="ExportObj_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B5;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="FitButton" Grid.Column="11" Content="适配视图" Click="FitButton_Click"/>

                    <!-- 外观：跟随系统 / 浅色 / 深色（选择存进 config.json 的 Theme） -->
                    <DropDownButton x:Name="ThemeButton" Grid.Column="10"
                                    AutomationProperties.Name="外观"
                                    ToolTipService.ToolTip="外观：跟随系统 / 浅色 / 深色">
                        <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="14"/>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Text="跟随系统"
                                                     GroupName="themeMode" Click="ThemeItem_Click" Tag="System"/>
                                <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="浅色"
                                                     GroupName="themeMode" Click="ThemeItem_Click" Tag="Light"/>
                                <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="深色"
                                                     GroupName="themeMode" Click="ThemeItem_Click" Tag="Dark"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button x:Name="SettingsButton" Grid.Column="12" Click="SettingsButton_Click"
                            ToolTipService.ToolTip="模型与贴图目录设置">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 中部空白（指针穿透到视口） -->
            <Grid Grid.Row="2"/>

            <!-- 底部状态栏 -->
            <Border x:Name="BottomBar" Grid.Row="3" Margin="14,0,14,14" CornerRadius="14"
                    BorderBrush="{ThemeResource AppPanelBorder}" BorderThickness="1" Padding="16,8" Background="{ThemeResource AppPanelBackground}">

                <StackPanel>
                    <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True"
                             Margin="0,0,0,4" Closed="NoticeBar_Closed"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Grid.Column="0" Text="就绪"
                                   Foreground="{ThemeResource AppTextStrong}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Foreground="{ThemeResource AppTextTertiary}" VerticalAlignment="Center"
                                   Text="左键拖动旋转 · 右键拖动平移 · 滚轮缩放"/>
                        <!-- Alpha 定时过期版角标：仅 ALPHA_EXPIRY 构建由代码显示，正式版恒为折叠 -->
                        <TextBlock x:Name="AlphaBadge" Grid.Column="2" Margin="14,0,0,0"
                                   Foreground="{ThemeResource AppAccent}" FontSize="12" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 模型库画廊 -->
        <Border x:Name="GalleryPanel" Width="388" Margin="14,58,0,76"
                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                CornerRadius="16" BorderBrush="{ThemeResource AppPanelBorder}" BorderThickness="1" Background="{ThemeResource AppPanelBackground}">

            <Grid Padding="10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,0,6,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="模型库" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GalleryCount" Text="" FontSize="12"
                                   Foreground="{ThemeResource AppTextTertiary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="刷新" FontSize="12" Padding="12,5"
                            Click="GalleryRefresh_Click"
                            ToolTipService.ToolTip="清除缓存并重新生成全部缩略图"/>
                </Grid>

                <!-- 模型搜索：实时过滤画廊，回车加载最佳匹配 -->
                <TextBox x:Name="SearchBox" Grid.Row="1" Margin="6,0,6,10"
                         PlaceholderText="搜索模型（实时过滤 · 回车加载）"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown"/>

                <GridView x:Name="Gallery" Grid.Row="2"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="Gallery_ItemClick"
                          PointerWheelChanged="Gallery_PointerWheelChanged"
                          ItemTemplate="{StaticResource ThumbTemplate}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
            </Grid>
        </Border>

        <!-- 模型信息卡片 -->
        <Border x:Name="InfoCard" Width="280" Margin="0,96,20,96"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                CornerRadius="16" BorderBrush="{ThemeResource AppPanelBorder}" BorderThickness="1"
                Padding="18,16" Visibility="Collapsed" Background="{ThemeResource AppPanelBackground}">

            <StackPanel Spacing="8">
                <TextBlock x:Name="InfoName" Text="" FontSize="15" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimary}" TextWrapping="Wrap"/>
                <TextBlock x:Name="InfoStats" Text="" FontSize="12.5"
                           Foreground="{ThemeResource AppTextSecondary}" TextWrapping="Wrap"/>
                <Border Height="1" Background="{ThemeResource AppDivider}" Margin="0,2"/>
                <TextBlock Text="BaseColor" FontSize="11" Foreground="{ThemeResource AppTextTertiary}"/>
                <TextBlock x:Name="InfoBase" Text="" FontSize="12"
                           Foreground="{ThemeResource AppTextValue}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="法线贴图" FontSize="11" Foreground="{ThemeResource AppTextTertiary}"/>
                <TextBlock x:Name="InfoNormal" Text="" FontSize="12"
                           Foreground="{ThemeResource AppTextValue}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="InfoSize" Text="" FontSize="12"
                           Foreground="{ThemeResource AppTextMuted}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 提示浮层（不拦截命中，仅在未加载模型或加载中显示） -->
        <Border x:Name="HintPill" HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="22" BorderBrush="{ThemeResource AppPanelBorder}" BorderThickness="1"
                Padding="28,22" IsHitTestVisible="False" Background="{ThemeResource AppPanelBackground}">

            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <ProgressRing x:Name="LoadingRing" IsActive="False" Width="34" Height="34"
                              Visibility="Collapsed" HorizontalAlignment="Center"/>
                <TextBlock x:Name="HintText" Text="从左侧模型库选择模型开始预览"
                           Foreground="{ThemeResource AppTextValue}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 水印层：铺满全屏的半透明水印（不拦截输入，位于加载/引导层之下） -->
        <Grid x:Name="WatermarkLayer" IsHitTestVisible="False" Opacity="0.14">
            <Canvas x:Name="WatermarkCanvas" SizeChanged="WatermarkCanvas_SizeChanged"/>
        </Grid>

        <!-- 加载层：完全加载完成前覆盖整个窗口，完成后淡出显示主界面 -->
        <Grid x:Name="LoadingLayer">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF10131A" Offset="0"/>
                    <GradientStop Color="#FF1E2631" Offset="0.55"/>
                    <GradientStop Color="#FF2A3543" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Width="420">
                <ProgressRing x:Name="LoadRing" IsActive="True" Width="58" Height="58"
                              HorizontalAlignment="Center"/>
                <TextBlock Text="UEFormat模型查看器" FontSize="24" FontWeight="SemiBold"
                           Foreground="#F0F4F9" HorizontalAlignment="Center"/>
                <ProgressBar x:Name="SplashProgress" IsIndeterminate="True" Height="4"/>
                <TextBlock x:Name="SplashStatus" Text="正在加载模型数据…"
                           HorizontalAlignment="Center" FontSize="13.5"
                           Foreground="#A9B4C2"/>
            </StackPanel>
        </Grid>

        <!-- 首次使用引导层：覆盖全窗口，引导用户配置模型与贴图目录 -->
        <Grid x:Name="FirstRunLayer" Visibility="Collapsed" Background="{ThemeResource AppOverlayScrim}">
            <Border x:Name="FirstRunCard" Width="560" MaxHeight="700" CornerRadius="20"
                    BorderBrush="{ThemeResource AppPanelBorder}" BorderThickness="1" Padding="40,34"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource AppPanelBackground}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="欢迎使用UEFormat格式查看工具" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="预览UEFormat模型：选择模型后自动加载对应 BaseColor 与法线贴图"
                                       FontSize="13" Foreground="{ThemeResource AppTextSecondary}" HorizontalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource AppDivider}"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="模型目录（含各模型子文件夹）" FontSize="12" Foreground="{ThemeResource AppTextMuted}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FirstRunModelsBox" Grid.Column="0"
                                         PlaceholderText="E:\deltamodel\...\Models\Props\Collect"/>
                                <Button x:Name="FirstRunModelsBrowse" Grid.Column="1" Content="浏览…"
                                        Click="FirstRunModelsBrowse_Click"/>
                            </Grid>
                            <TextBlock x:Name="FirstRunModelsHint" Text="目录不存在，请检查路径" FontSize="11.5"
                                       Foreground="{ThemeResource AppDanger}" Visibility="Collapsed"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="贴图目录（BaseColor / NRM 法线贴图，结构与模型目录同名）" FontSize="12" Foreground="{ThemeResource AppTextMuted}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FirstRunTexturesBox" Grid.Column="0"
                                         PlaceholderText="F:\FModel-dec-2025\...\Models\Props\Collect"/>
                                <Button x:Name="FirstRunTexturesBrowse" Grid.Column="1" Content="浏览…"
                                        Click="FirstRunTexturesBrowse_Click"/>
                            </Grid>
                            <TextBlock x:Name="FirstRunTexturesHint" Text="目录不存在，请检查路径" FontSize="11.5"
                                       Foreground="{ThemeResource AppDanger}" Visibility="Collapsed"/>
                        </StackPanel>

                        <StackPanel Spacing="10" Margin="0,4,0,0">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="FirstRunStart" Grid.Column="0" Content="开始使用"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch" Click="FirstRunStart_Click"/>
                                <Button x:Name="FirstRunSkip" Grid.Column="1" Content="跳过"
                                        HorizontalAlignment="Stretch" Click="FirstRunSkip_Click"
                                        ToolTipService.ToolTip="稍后再配置"/>
                            </Grid>
                            <TextBlock Text="左键拖动旋转 · 右键拖动平移 · 滚轮缩放" FontSize="11.5"
                                       Foreground="{ThemeResource AppTextTertiary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
